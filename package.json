{
  "name": "squeek-settlement-latency",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Squeekchain Sepolia settlement-latency tracker with a local dashboard.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "tsx src/cli/verify.ts",
    "track": "tsx src/cli/track.ts",
    "serve": "tsx src/cli/serve.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite",
    "build": "vite build && tsx src/cli/copy-data.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
